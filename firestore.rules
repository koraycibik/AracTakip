rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /vehicles/{vehicleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.ownerUid == uid
          && request.resource.data.type in ['car', 'motorcycle', 'atv', 'van', 'truck', 'minibus', 'bus'];

        match /records/{recordId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.ownerUid == uid
            && request.resource.data.amountKurus is int
            && request.resource.data.amountKurus >= 0
            && (!('note' in request.resource.data)
                || request.resource.data.note == null
                || request.resource.data.note.size() <= 1000)
            && (!('serviceName' in request.resource.data)
                || request.resource.data.serviceName == null
                || request.resource.data.serviceName.size() <= 80)
            && (!('insuranceKind' in request.resource.data)
                || request.resource.data.insuranceKind == null
                || request.resource.data.insuranceKind in ['traffic', 'casco']);
        }
        match /maintenanceItems/{itemId} {
          allow read, write: if isOwner(uid);
        }
        match /accidents/{accidentId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.damageKurus is int
            && request.resource.data.damageKurus >= 0
            && request.resource.data.description.size() <= 2000;
        }
      }

      match /reminders/{reminderId} {
        allow read, write: if isOwner(uid);
      }

      // Usta defteri: servise verilen puan (0–5) ve kişisel not.
      match /workshops/{workshopId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.rating is int
          && request.resource.data.rating >= 0
          && request.resource.data.rating <= 5
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && (!('city' in request.resource.data) || request.resource.data.city == null
              || (request.resource.data.city is string && request.resource.data.city.size() <= 40));
      }
    }

    // "Tüm araçlar" istatistiği: collection group sorgusu
    match /{path=**}/records/{recordId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Marka/model kataloğu: herkes okur, sadece Firebase konsolundan yazılır.
    // Belge yapısı: catalog/{car|motorcycle|...} → { brands: [ {brand, models: [...]}, ... ] }
    match /catalog/{type} {
      allow read: if true;
      allow write: if false;
    }

    // Araç devri: satıcı alıcının e-postasına teklif yazar (belge kimliği
    // "{satıcıUid}_{araçId}", araç başına tek teklif). Alıcı, Google ile
    // doğrulanmış aynı e-postayla giriş yaptıysa okur ve kabul/ret/engel yazar.
    match /transfers/{transferId} {
      function isSender() {
        return signedIn() && resource.data.fromUid == request.auth.uid;
      }
      function isRecipient() {
        return signedIn()
          && request.auth.token.email != null
          && request.auth.token.email_verified == true
          && resource.data.toEmail == request.auth.token.email.lower();
      }
      allow read: if isSender() || isRecipient();
      allow create: if signedIn()
        && transferId == request.auth.uid + '_' + request.resource.data.vehicleId
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toEmail is string
        && request.resource.data.toEmail.size() <= 120
        && request.resource.data.status == 'pending'
        && request.resource.data.attempts is int
        && request.resource.data.attempts >= 1
        && request.resource.data.attempts <= 3;
      allow update: if
        // Satıcı: tekrar gönderir ya da iptal eder (alıcı engellediyse yapamaz).
        (isSender()
          && resource.data.status != 'blocked'
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.vehicleId == resource.data.vehicleId
          && request.resource.data.status in ['pending', 'cancelled']
          && request.resource.data.attempts is int
          && request.resource.data.attempts <= 3)
        // Alıcı: durumu ve cevap tarihini yazar. Reddederken satıcının verisini
        // (payload) de siler; böylece reddedilen teklifte veri kalmaz.
        || (isRecipient()
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'payload'])
          && (request.resource.data.status == 'accepted'
              || (request.resource.data.status in ['declined', 'blocked'] && request.resource.data.payload == null)));
      allow delete: if isSender() && resource.data.status != 'blocked';
    }

    // Paylaşılan araç raporu: bağlantıyı bilen herkes 30 gün okuyabilir.
    match /shares/{shareId} {
      allow get: if resource.data.revoked == false
        && request.time < resource.data.expiresAt;
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.expiresAt <= request.time + duration.value(31, 'd');
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
